<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.chatapplication.Client">
    <children>
        <VBox layoutX="10.0" layoutY="10.0" prefHeight="580.0" prefWidth="780.0" spacing="10.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <!-- Title Label -->
                <Label alignment="CENTER" prefWidth="760.0" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Client Application" />

                <!-- Chat Display Area - LARGE -->
                <TextArea fx:id="chatArea" editable="false" prefHeight="450.0" prefWidth="760.0" promptText="Chat messages will appear here..." style="-fx-font-size: 14px;" wrapText="true" />

                <!-- Message Input Area - LARGER TYPING AREA -->
                <HBox alignment="CENTER_LEFT" prefHeight="80.0" prefWidth="760.0" spacing="10.0">
                    <children>
                        <Label prefWidth="70.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Message:" />
                        <TextField fx:id="messageField" prefHeight="60.0" promptText="Type your message here..." style="-fx-font-size: 14px;" HBox.hgrow="ALWAYS" />
                        <Button fx:id="sendButton" onAction="#sendMessage" prefHeight="60.0" prefWidth="100.0" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;" text="Send" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
